<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>FactoryClassic.Server</RootNamespace>
    <AssemblyName>FactoryClassic.Server</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <Version>$(ModVersion)</Version>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="SPTarkov.Common" Version="4.1.0" />
    <PackageReference Include="SPTarkov.DI" Version="4.1.0" />
    <PackageReference Include="SPTarkov.Server.Core" Version="4.1.0" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\FactoryClassic.Shared\*.cs" Link="Shared\%(Filename)%(Extension)" />
  </ItemGroup>
  <Target Name="StageServer" AfterTargets="Build">
    <PropertyGroup><StageDir>$(DistRoot)SPT_Runtime\user\mods\$(PluginFolder)\</StageDir></PropertyGroup>
    <ItemGroup><DbFiles Include="$(ProjectDir)db\**\*.*" /></ItemGroup>
    <ItemGroup><ConfigFiles Include="$(ProjectDir)config\**\*.*" /></ItemGroup>
    <MakeDir Directories="$(StageDir)" />
    <Copy SourceFiles="$(TargetPath);$(ProjectDir)$(OutDir)$(AssemblyName).deps.json" DestinationFolder="$(StageDir)" />
    <Copy SourceFiles="@(DbFiles)" DestinationFiles="@(DbFiles->'$(StageDir)db\%(RecursiveDir)%(Filename)%(Extension)')" />
    <Copy SourceFiles="@(ConfigFiles)" DestinationFiles="@(ConfigFiles->'$(StageDir)config\%(RecursiveDir)%(Filename)%(Extension)')" />
    <Message Importance="high" Text="staged server to $(StageDir)" />
  </Target>
</Project>
