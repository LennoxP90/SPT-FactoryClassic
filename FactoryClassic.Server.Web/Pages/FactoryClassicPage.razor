@page "/factoryclassic"
@* Administrator, matching every other page that writes config. *@
@attribute [Authorize(Policy = "Administrator")]
@layout SPTarkov.Server.Web.Layout.BaseMudBlazorLayout

<PageTitle>FactoryClassic</PageTitle>

<MudMainContent>
  <MudContainer MaxWidth="MaxWidth.Small" Class="pa-6">

    <MudPaper Class="pa-6 mb-4" Elevation="4">
      <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
        <div>
          <MudText Typo="Typo.h4">FactoryClassic</MudText>
          <MudText Typo="Typo.body2" Class="mud-text-secondary">The pre-rework Factory</MudText>
        </div>
        <MudStack Row="true" Spacing="2">
          <MudButton StartIcon="@Icons.Material.Filled.Refresh" Variant="Variant.Outlined" OnClick="Reload">Reload</MudButton>
          <MudButton StartIcon="@Icons.Material.Filled.Save" Variant="Variant.Filled" Color="Color.Primary"
                     OnClick="Save" Disabled="@(!dirty)">Save changes</MudButton>
        </MudStack>
      </MudStack>
    </MudPaper>

    @if (message is not null)
    {
      <MudAlert Severity="@severity" Class="mb-4" ShowCloseIcon="true" CloseIconClicked="@(() => message = null)">@message</MudAlert>
    }

    <MudAlert Severity="Severity.Info" Class="mb-4">
      Both settings are read when the server starts, so a change applies after the next server restart.
      Halloween 2026 is not set here: players pick it on the map screen as its own Factory variant.
    </MudAlert>

    <MudPaper Class="pa-6 mb-4" Elevation="2">
      <MudText Typo="Typo.h6">Loot</MudText>
      <MudText Typo="Typo.body2" Class="mud-text-secondary mb-4">
        Classic keeps the 3.9.8 loot tables as they were. Hybrid adds 4.1's items alongside them. Modern replaces
        them with 4.1's.
      </MudText>
      <MudSelect T="string" Label="Loot mode" Variant="Variant.Outlined"
                 Value="@config.LootMode" ValueChanged="@(v => { config.LootMode = v; dirty = true; })">
        <MudSelectItem Value="@("classic")">Classic</MudSelectItem>
        <MudSelectItem Value="@("hybrid")">Hybrid</MudSelectItem>
        <MudSelectItem Value="@("modern")">Modern</MudSelectItem>
      </MudSelect>
    </MudPaper>

    <MudPaper Class="pa-6" Elevation="2">
      <MudText Typo="Typo.h6">Quests</MudText>
      <MudText Typo="Typo.body2" Class="mud-text-secondary mb-4">
        For the quests that cannot be finished on Classic. Warn names any the player has accepted in the map choice
        window and asks them to confirm. Hide also keeps them off the trader board while both Factory locations
        serve Classic. Off says nothing.
      </MudText>
      <MudSelect T="string" Label="Quest gate" Variant="Variant.Outlined"
                 Value="@config.QuestGate" ValueChanged="@(v => { config.QuestGate = v; dirty = true; })">
        <MudSelectItem Value="@("warn")">Warn</MudSelectItem>
        <MudSelectItem Value="@("hide")">Hide</MudSelectItem>
        <MudSelectItem Value="@("off")">Off</MudSelectItem>
      </MudSelect>
    </MudPaper>

  </MudContainer>
</MudMainContent>

@code {
  private ServerConfig config = new();
  private bool dirty;
  private string? message;
  private Severity severity = Severity.Info;

  protected override void OnInitialized() => Reload();

  private void Reload()
  {
    config = ServerConfigFile.Read(ServerConfigFile.DefaultPath);
    dirty = false;
  }

  private void Save()
  {
    try
    {
      ServerConfigFile.Write(ServerConfigFile.DefaultPath, config);
      dirty = false;
      (message, severity) = ("Saved. Restart the server for it to apply.", Severity.Success);
    }
    catch (Exception e)
    {
      (message, severity) = ($"Saving failed: {e.Message}", Severity.Error);
    }
  }
}
